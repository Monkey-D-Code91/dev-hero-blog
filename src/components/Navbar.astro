---
import { getLangFromUrl, useTranslations } from "../i18n/utils";
import { BLOG } from "../config";
import LanguageSwitcher from "./LanguageSwitcher.astro";
import MobileMenu from "./MobileMenu.tsx";

interface Props {
  itHref?: string;
  enHref?: string;
}

const { itHref = "/", enHref = "/en/" } = Astro.props;
const lang = getLangFromUrl(Astro.url);
const t = useTranslations(lang);

const homeHref = lang === "it" ? "/" : "/en/";
const blogHref = lang === "it" ? "/blog/" : "/en/blog/";
const roadmapHref = lang === "it" ? "/roadmap/" : "/en/roadmap/";
const questionsHref = lang === "it" ? "/domande-aperte/" : "/en/open-questions/";
const authorsHref = lang === "it" ? "/autori/" : "/en/authors/";

const pathname = Astro.url.pathname;

function isActive(href: string): boolean {
  if (href === "/" || href === "/en/") return pathname === href;
  return pathname.startsWith(href);
}

const links = [
  { href: homeHref, label: t.nav.home },
  { href: blogHref, label: t.blog.nav },
  { href: roadmapHref, label: t.roadmap.nav },
  { href: questionsHref, label: t.openQuestions.nav },
  { href: authorsHref, label: t.nav.authors },
];
---

<header
  class="sticky top-0 z-40 border-b border-border/60 bg-bg/80 backdrop-blur-md"
>
  <div class="mx-auto flex max-w-5xl items-center justify-between px-6 py-3">
    <a
      href={homeHref}
      class="group flex items-center gap-2.5"
      aria-label={BLOG.name}
    >
      <img
        src={BLOG.logo}
        alt=""
        aria-hidden="true"
        class="h-9 w-9 rounded-lg"
      />
      <span class="hidden font-semibold tracking-tight sm:inline"
        >{BLOG.name}</span
      >
    </a>

    <nav class="hidden items-center gap-8 md:flex" aria-label="Primary">
      {
        links.map((link) => (
          <a
            href={link.href}
            class:list={[
              "text-sm transition-colors",
              isActive(link.href)
                ? "border-b border-accent pb-px font-medium text-text"
                : "text-muted hover:text-text",
            ]}
          >
            {link.label}
          </a>
        ))
      }
    </nav>

    <div class="flex items-center gap-3 sm:gap-4">
      <LanguageSwitcher itHref={itHref} enHref={enHref} />
      <MobileMenu
        client:load
        links={links}
        brandName={BLOG.name}
        activePath={pathname}
        labels={{ menu: t.nav.menu, close: t.nav.close }}
      />
    </div>
  </div>
</header>
