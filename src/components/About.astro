---
import { getLangFromUrl, useTranslations } from "../i18n/utils";
import type { CollectionEntry } from "astro:content";

interface Props {
  author: CollectionEntry<"authors">["data"];
  articleCount?: number;
}

const { author, articleCount } = Astro.props;
const lang = getLangFromUrl(Astro.url);
const t = useTranslations(lang);

// Costruisce l'array delle stats, saltando i campi opzionali non presenti.
const stats = [
  { value: author.stats.years, label: t.about.stats.years },
  ...(author.stats.teamSize
    ? [{ value: author.stats.teamSize, label: t.about.stats.teamSize }]
    : []),
  ...(author.stats.countries
    ? [{ value: author.stats.countries, label: t.about.stats.countries }]
    : []),
  ...(articleCount !== undefined && articleCount > 0
    ? [{ value: String(articleCount), label: t.about.stats.articles }]
    : []),
];
---

<section id="about" class="scroll-mt-20 border-t border-border py-20 md:py-24">
  <div class="mx-auto max-w-5xl px-6">
    <header data-reveal>
      <p class="text-sm font-semibold uppercase tracking-widest text-accent">
        {t.about.heading}
      </p>
      <h2 class="mt-2 max-w-2xl text-3xl font-bold tracking-tight sm:text-4xl">
        {author.aboutLead}
      </h2>
    </header>

    <div class="mt-10 grid gap-12 md:grid-cols-[1.4fr_1fr]">
      <!-- Bio (corpo markdown dell'autore) -->
      <div data-reveal class="author-body space-y-5">
        <slot />
      </div>

      <dl data-reveal class="grid grid-cols-3 gap-4 md:grid-cols-1 md:gap-0">
        {
          stats.map((s, i) => (
            <div
              class:list={[
                "py-4 md:py-5",
                i > 0 && "md:border-t md:border-border",
              ]}
            >
              <dt class="sr-only">{s.label}</dt>
              <dd>
                <span class="block text-3xl font-bold text-accent sm:text-4xl">
                  {s.value}
                </span>
                <span class="mt-1 block text-sm text-muted">{s.label}</span>
              </dd>
            </div>
          ))
        }
      </dl>
    </div>
  </div>
</section>

<style>
  /* Stile per i paragrafi del corpo markdown dell'autore. */
  .author-body :global(p) {
    font-size: 1rem;
    line-height: 1.75;
    color: var(--color-text-muted);
  }
  @media (min-width: 640px) {
    .author-body :global(p) {
      font-size: 1.125rem;
    }
  }
</style>
