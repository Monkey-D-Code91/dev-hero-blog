---
import type { Lang } from "../../i18n/ui";
import { useTranslations } from "../../i18n/utils";
import { getOpenQuestions } from "../../utils/questions";

/** Sezione "Domande aperte": raccoglie le domande in sospeso degli articoli. */
interface Props {
  lang: Lang;
}

const { lang } = Astro.props;
const t = useTranslations(lang);
const tq = t.openQuestions;

const { questions, openCount, resumedCount } = await getOpenQuestions(lang);
---

<section class="py-16 md:py-20">
  <div class="mx-auto max-w-3xl px-6">
    <header>
      <p class="text-sm font-semibold uppercase tracking-widest text-accent">
        {tq.eyebrow}
      </p>
      <h1
        class="mt-3 font-serif text-4xl font-semibold leading-tight tracking-tight text-text sm:text-[2.75rem]"
      >
        {tq.heading}
      </h1>
      <p class="mt-5 text-lg leading-relaxed text-muted">{tq.intro}</p>
      {
        questions.length > 0 && (
          <p class="mt-4 text-sm text-muted/80">
            {tq.countCaption(openCount, resumedCount)}
          </p>
        )
      }
    </header>

    {
      questions.length === 0 ? (
        <p class="mt-10 rounded-xl border border-border bg-surface-2 px-6 py-5 text-sm text-muted">
          {tq.empty}
        </p>
      ) : (
        <ul class="mt-10 space-y-5">
          {questions.map((q) => (
            <li class="rounded-2xl border border-border border-l-2 border-l-accent/60 bg-surface-2 p-6">
              <p class="font-serif text-xl leading-snug text-text">
                {q.question}
              </p>
              <div class="mt-4 flex flex-wrap items-center gap-x-3 gap-y-2 text-sm text-muted">
                <span>
                  {tq.fromLabel + ": "}
                  <a
                    href={q.sourceHref}
                    class="font-medium text-text transition-colors hover:text-accent"
                  >
                    {q.sourceTitle}
                  </a>
                </span>
                <span class="opacity-40" aria-hidden="true">
                  ·
                </span>
                {q.status === "resumed" ? (
                  <span class="inline-flex items-center gap-1.5">
                    <span class="rounded-full bg-accent/10 px-2 py-0.5 text-xs font-semibold text-accent">
                      {tq.statusResumed}
                    </span>
                    {q.resumedHref && (
                      <a
                        href={q.resumedHref}
                        class="text-muted transition-colors hover:text-accent"
                      >
                        {tq.resumedInLabel}: {q.resumedTitle}
                      </a>
                    )}
                  </span>
                ) : (
                  <span class="rounded-full border border-border px-2 py-0.5 text-xs font-semibold text-muted">
                    {tq.statusOpen}
                  </span>
                )}
              </div>
            </li>
          ))}
        </ul>
      )
    }
  </div>
</section>
