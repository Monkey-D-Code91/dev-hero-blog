---
import { getLangFromUrl, useTranslations } from "../i18n/utils";
import type { CollectionEntry } from "astro:content";

interface Props {
  author: CollectionEntry<"authors">["data"];
}

const { author } = Astro.props;
const lang = getLangFromUrl(Astro.url);
const t = useTranslations(lang);
---

<section
  id="contact"
  class="scroll-mt-20 border-t border-border bg-surface py-20 md:py-28"
>
  <div
    class="relative mx-auto max-w-3xl overflow-hidden rounded-3xl border border-border bg-gradient-to-br from-surface-2 to-bg px-6 py-14 text-center sm:px-12"
    data-reveal
  >
    <div
      class="pointer-events-none absolute left-1/2 top-0 h-64 w-96 -translate-x-1/2 rounded-full opacity-30 blur-3xl"
      aria-hidden="true"
      style="background: radial-gradient(circle, #38bdf8 0%, transparent 65%);"
    >
    </div>

    <h2 class="text-3xl font-bold tracking-tight sm:text-4xl">
      {t.contact.heading}
    </h2>
    <p class="mx-auto mt-4 max-w-xl text-base leading-relaxed text-muted">
      {t.contact.lead}
    </p>

    {author.links.linkedin && (
      <a
        href={author.links.linkedin}
        target="_blank"
        rel="noopener noreferrer"
        class="mt-8 inline-flex items-center justify-center gap-2.5 rounded-lg bg-accent px-6 py-3.5 text-sm font-semibold text-bg transition-opacity hover:opacity-90"
      >
        <svg width="18" height="18" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true">
          <path d="M20.45 20.45h-3.56v-5.57c0-1.33-.02-3.04-1.85-3.04-1.85 0-2.13 1.45-2.13 2.94v5.67H9.35V9h3.41v1.56h.05c.48-.9 1.64-1.85 3.37-1.85 3.6 0 4.27 2.37 4.27 5.45v6.29zM5.34 7.43a2.06 2.06 0 1 1 0-4.13 2.06 2.06 0 0 1 0 4.13zM7.12 20.45H3.56V9h3.56v11.45zM22.22 0H1.77C.79 0 0 .77 0 1.73v20.54C0 23.23.79 24 1.77 24h20.45c.98 0 1.78-.77 1.78-1.73V1.73C24 .77 23.2 0 22.22 0z"></path>
        </svg>
        {t.contact.cta}
      </a>
    )}
  </div>
</section>
