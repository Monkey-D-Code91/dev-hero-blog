---
import type { ResolvedArc, RoadmapStatus } from "../../utils/roadmap";
import RoadmapItemCard from "./RoadmapItemCard.astro";
import RoadmapProgress from "./RoadmapProgress.astro";

/**
 * Un capitolo della roadmap: numerale, titolo, occhiello, periodo, barra di
 * avanzamento (solo se l'arco ha tappe) e griglia delle tappe. In coda, l'eventuale teaser di un filone
 * ancora in definizione (mostrato come invito, senza data).
 */
interface Props {
  arc: ResolvedArc;
  statusLabels: Record<RoadmapStatus, string>;
  progressCaption: string;
  progressAria: string;
}

const { arc, statusLabels, progressCaption, progressAria } = Astro.props;
---

<section class="py-8" data-reveal aria-labelledby={`arc-${arc.arcKey}`}>
  <div class="flex items-baseline gap-4">
    <span
      class="select-none text-4xl font-extrabold leading-none text-border"
      aria-hidden="true">{arc.numeral}</span>
    <div>
      <h2 id={`arc-${arc.arcKey}`} class="text-xl font-bold tracking-tight">
        {arc.title}
      </h2>
      <p class="mt-1 text-xs text-muted">{arc.period} · {arc.signature}</p>
    </div>
  </div>

  <p class="mt-3 max-w-2xl pl-0 text-sm leading-relaxed text-muted sm:pl-12">
    {arc.lead}
  </p>

  {
    arc.progress.total > 0 && (
      <div class="mt-4 sm:pl-12">
        <RoadmapProgress
          done={arc.progress.done}
          total={arc.progress.total}
          label={progressAria}
          caption={progressCaption}
        />
      </div>
    )
  }

  <div class="mt-6 grid gap-3 sm:grid-cols-2 sm:pl-12">
    {
      arc.items.map((item) => (
        <RoadmapItemCard item={item} statusLabel={statusLabels[item.status]} />
      ))
    }
  </div>

  {
    arc.upcomingTeaser && (
      <div class="mt-3 rounded-2xl border border-dashed border-border-strong/60 bg-surface/40 p-4 sm:ml-12">
        <p class="text-xs font-semibold uppercase tracking-widest text-accent-2">
          {arc.upcomingTeaser.label}
        </p>
        <p class="mt-1.5 max-w-2xl text-sm leading-relaxed text-muted">
          {arc.upcomingTeaser.text}
        </p>
      </div>
    )
  }
</section>
