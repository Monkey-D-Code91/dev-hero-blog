---
import type { CollectionEntry } from "astro:content";
import type { Lang } from "../../i18n/ui";
import { useTranslations } from "../../i18n/utils";
import AuthorCard from "./AuthorCard.astro";

interface Props {
  authors: CollectionEntry<"authors">[];
  lang: Lang;
}

const { authors, lang } = Astro.props;
const t = useTranslations(lang);

const items = authors.map((entry) => {
  const slug = entry.id.split("/").slice(1).join("/");
  const profileHref = lang === "it" ? `/autori/${slug}/` : `/en/authors/${slug}/`;
  return { data: entry.data, profileHref };
});

const headingIT = "Tutti gli autori di First Draft.";
const headingEN = "All First Draft authors.";
---

<section class="py-20 md:py-24">
  <div class="mx-auto max-w-5xl px-6">
    <header data-reveal>
      <p class="text-sm font-semibold uppercase tracking-widest text-accent">
        {lang === "it" ? "Autori" : "Authors"}
      </p>
      <h1 class="mt-2 max-w-2xl text-3xl font-bold tracking-tight sm:text-4xl">
        {lang === "it" ? headingIT : headingEN}
      </h1>
    </header>

    {
      items.length === 0 ? (
        <p class="mt-12 text-muted" data-reveal>
          {lang === "it" ? "Nessun autore ancora pubblicato." : "No authors yet."}
        </p>
      ) : (
        <div class="mt-12 grid gap-6 sm:grid-cols-2 md:grid-cols-3 lg:grid-cols-4">
          {items.map((item, i) => (
            <div
              class="h-full"
              data-reveal
              data-reveal-delay={i > 0 ? String(Math.min(i, 3)) : undefined}
            >
              <AuthorCard
                name={item.data.name}
                role={item.data.role}
                badge={item.data.badge}
                monogram={item.data.monogram}
                avatar={item.data.avatar}
                avatarAlt={item.data.avatarAlt}
                profileHref={item.profileHref}
                lang={lang}
              />
            </div>
          ))}
        </div>
      )
    }
  </div>
</section>
