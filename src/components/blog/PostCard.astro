---
import { Image } from "astro:assets";
import type { ImageMetadata } from "astro";
import type { Lang } from "../../i18n/ui";
import type { BlogFocus, PostAuthor } from "../../utils/blog";
import FocusTriad from "./FocusTriad.astro";
import TagPill from "./TagPill.astro";
import { formatDate, getBlogPostUrl, getAuthorUrl } from "../../utils/blog";

interface Props {
  title: string;
  description: string;
  pubDate: Date;
  slug: string;
  tags: string[];
  lang: Lang;
  focus?: BlogFocus[];
  readingTime: string;
  cover?: ImageMetadata;
  coverAlt?: string;
  authors: PostAuthor[];
  /** Variante in evidenza (indice blog): card scalata, titolo più grande. */
  featured?: boolean;
}

const {
  title,
  description,
  pubDate,
  slug,
  tags,
  lang,
  focus = [],
  readingTime,
  cover,
  coverAlt,
  authors,
  featured = false,
} = Astro.props;

const conj = lang === "it" ? "e" : "and";

const url = getBlogPostUrl(lang, slug);
const dateStr = formatDate(pubDate, lang);

// ID univoco per aria-labelledby (collegamento articolo ↔ titolo)
const titleId = `card-title-${slug}`;
---

<!--
  Card accessibile: l'<article> è labellato dall'<h2> tramite aria-labelledby.
  Il titolo è il link principale; i tag sono <span> non interattivi (evita
  link annidati nel contesto lista).
-->
<article
  class="group card-lift relative flex h-full flex-col rounded-2xl border border-border bg-surface-2 overflow-hidden transition-colors hover:border-accent/40"
  aria-labelledby={titleId}
>
  <!-- Cover o striscia decorativa -->
  {
    cover ? (
      <Image
        src={cover}
        alt={coverAlt ?? ""}
        width={featured ? 900 : 600}
        height={featured ? 470 : 314}
        class="w-full h-auto"
      />
    ) : (
      <div
        class="h-1 w-full bg-gradient-to-r from-accent/20 via-accent to-accent-2/20 shrink-0"
        aria-hidden="true"
      />
    )
  }

  <div class:list={["flex flex-col flex-1 p-6", featured && "md:p-8"]}>
    <!-- Byline autore/i con avatar/monogramma -->
    <div class="flex flex-wrap items-center gap-x-2 gap-y-1 text-xs text-muted">
      {
        authors.map((author, i) => (
          <>
            {i > 0 && (
              <span class="opacity-70">
                {i === authors.length - 1 ? ` ${conj} ` : ", "}
              </span>
            )}
            <a
              href={getAuthorUrl(author.key, lang)}
              class="relative z-10 inline-flex items-center gap-1 font-medium text-accent/80 hover:text-accent transition-colors"
            >
              {author.avatar ? (
                <Image
                  src={author.avatar}
                  alt={author.avatarAlt ?? author.name}
                  width={20}
                  height={20}
                  class="h-5 w-5 rounded-full border border-border object-cover shrink-0"
                />
              ) : (
                <span
                  class="inline-flex h-5 w-5 items-center justify-center rounded-full border border-border bg-bg text-[8px] font-bold text-accent shrink-0"
                  aria-hidden="true"
                >
                  {author.monogram}
                </span>
              )}
              {author.name}
            </a>
          </>
        ))
      }
      <span class="mx-1 opacity-50" aria-hidden="true">·</span>
      <time datetime={pubDate.toISOString()}>{dateStr}</time>
      {readingTime && <span class="mx-1 opacity-50" aria-hidden="true">·</span>}
      {readingTime && <span aria-label={lang === "it" ? `Tempo di lettura: ${readingTime}` : `Reading time: ${readingTime}`}>{readingTime}</span>}
      {focus.length > 0 && <span class="mx-1 opacity-50" aria-hidden="true">·</span>}
      <FocusTriad focus={focus} lang={lang} />
    </div>

    <!-- Titolo — link principale della card -->
    <h2
      id={titleId}
      class:list={[
        "mt-3 font-semibold leading-snug",
        featured ? "text-xl sm:text-2xl" : "text-lg",
      ]}
    >
      <a
        href={url}
        class="text-text transition-colors group-hover:text-accent after:absolute after:inset-0"
      >
        {title}
      </a>
    </h2>

    <!-- Descrizione -->
    <p
      class:list={[
        "mt-2 leading-relaxed text-muted flex-1",
        featured ? "text-base" : "text-sm",
      ]}
    >
      {description}
    </p>

    <!-- Tag (non-link nelle card: evita link annidati nel contesto lista) -->
    {
      tags.length > 0 && (
        <div class="mt-4 flex flex-wrap gap-1.5" aria-label={lang === "it" ? "Tag" : "Tags"}>
          {tags.map((tag) => (
            <TagPill tag={tag} lang={lang} link={false} />
          ))}
        </div>
      )
    }
  </div>
</article>
