---
import { Image } from "astro:assets";
import type { ImageMetadata } from "astro";
import type { Lang } from "../../i18n/ui";
import TagPill from "./TagPill.astro";
import { formatDate, getBlogPostUrl, getAuthorUrl } from "../../utils/blog";

interface Props {
  title: string;
  description: string;
  pubDate: Date;
  slug: string;
  tags: string[];
  lang: Lang;
  readingTime: string;
  cover?: ImageMetadata;
  coverAlt?: string;
  authorKey: string;
  authorName: string;
}

const { title, description, pubDate, slug, tags, lang, readingTime, cover, coverAlt, authorKey, authorName } =
  Astro.props;

const authorUrl = getAuthorUrl(authorKey, lang);

const url = getBlogPostUrl(lang, slug);
const dateStr = formatDate(pubDate, lang);

// ID univoco per aria-labelledby (collegamento articolo ↔ titolo)
const titleId = `card-title-${slug}`;
---

<!--
  Card accessibile: l'<article> è labellato dall'<h2> tramite aria-labelledby.
  Il titolo è il link principale; i tag sono <span> non interattivi (evita
  link annidati nel contesto lista).
-->
<article
  class="group flex h-full flex-col rounded-2xl border border-border bg-surface-2 overflow-hidden transition-colors hover:border-accent/40"
  aria-labelledby={titleId}
>
  <!-- Cover o striscia decorativa -->
  {
    cover ? (
      <Image
        src={cover}
        alt={coverAlt ?? ""}
        width={600}
        height={288}
        class="w-full h-48 object-cover"
      />
    ) : (
      <div
        class="h-1 w-full bg-gradient-to-r from-accent/20 via-accent to-accent-2/20 shrink-0"
        aria-hidden="true"
      />
    )
  }

  <div class="flex flex-col flex-1 p-6">
    <!-- Byline autore -->
    <p class="text-xs text-muted">
      <a href={authorUrl} class="font-medium text-accent/80 hover:text-accent transition-colors">
        {authorName}
      </a>
      <span class="mx-1.5 opacity-50" aria-hidden="true">·</span>
      <time datetime={pubDate.toISOString()}>{dateStr}</time>
      {readingTime && <span class="mx-1.5 opacity-50" aria-hidden="true">·</span>}
      {readingTime && <span aria-label={lang === "it" ? `Tempo di lettura: ${readingTime}` : `Reading time: ${readingTime}`}>{readingTime}</span>}
    </p>

    <!-- Titolo — link principale della card -->
    <h2 id={titleId} class="mt-3 text-lg font-semibold leading-snug">
      <a
        href={url}
        class="text-text transition-colors group-hover:text-accent"
      >
        {title}
      </a>
    </h2>

    <!-- Descrizione -->
    <p class="mt-2 text-sm leading-relaxed text-muted flex-1">
      {description}
    </p>

    <!-- Tag (non-link nelle card: evita link annidati nel contesto lista) -->
    {
      tags.length > 0 && (
        <div class="mt-4 flex flex-wrap gap-1.5" aria-label={lang === "it" ? "Tag" : "Tags"}>
          {tags.map((tag) => (
            <TagPill tag={tag} lang={lang} link={false} />
          ))}
        </div>
      )
    }
  </div>
</article>
