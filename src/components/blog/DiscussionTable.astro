---
/**
 * "Dal tavolo di discussione" — scambi selezionati tornati nel pezzo dopo la
 * pubblicazione (LinkedIn, commenti). Incarna il principio del manifesto:
 * la discussione fa parte del pezzo, non gli sta accanto. Reso solo se ci sono
 * scambi; attribuzione per ruolo (regola privacy).
 */
import type { Lang } from "../../i18n/ui";
import { useTranslations } from "../../i18n/utils";

export interface DiscussionEntry {
  from: string;
  quote: string;
  reply?: string;
  via?: string;
}

interface Props {
  entries: DiscussionEntry[];
  lang: Lang;
}

const { entries, lang } = Astro.props;
const t = useTranslations(lang);
---

{
  entries.length > 0 && (
    <section
      class="mt-16 rounded-2xl border border-border bg-surface-2/60 px-6 py-8 sm:px-8"
      aria-labelledby="discussion-heading"
    >
      <p
        id="discussion-heading"
        class="text-sm font-semibold uppercase tracking-widest text-accent"
      >
        {t.blog.discussionHeading}
      </p>
      <p class="mt-2 text-sm text-muted">{t.blog.discussionIntro}</p>

      <ul class="mt-8 flex flex-col gap-8">
        {entries.map((e) => (
          <li class="border-l-2 border-accent/40 pl-5">
            <blockquote class="font-serif text-lg italic leading-relaxed text-text">
              {e.quote}
            </blockquote>
            <p class="mt-2 text-sm text-muted">
              {e.from}
              {e.via && <span class="text-muted/70"> · {e.via}</span>}
            </p>
            {e.reply && (
              <div class="mt-4 pl-4 border-l-2 border-border">
                <p class="text-xs font-semibold uppercase tracking-wider text-accent-2">
                  {t.blog.discussionReplyLabel}
                </p>
                <p class="mt-1 leading-relaxed text-text/90">{e.reply}</p>
              </div>
            )}
          </li>
        ))}
      </ul>
    </section>
  )
}
