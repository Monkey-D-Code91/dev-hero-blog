---
import type { ProcessedPost } from "../../utils/blog";
import { getLangFromUrl, useTranslations } from "../../i18n/utils";
import PostCard from "./PostCard.astro";

interface Props {
  posts: ProcessedPost[];
}

const { posts } = Astro.props;
const lang = getLangFromUrl(Astro.url);
const t = useTranslations(lang);
---

<section class="py-20 md:py-24">
  <div class="mx-auto max-w-5xl px-6">
    <!-- Header di sezione -->
    <header data-reveal>
      <p class="text-sm font-semibold uppercase tracking-widest text-accent">
        {t.blog.heading}
      </p>
      <h1 class="mt-2 max-w-2xl text-3xl font-bold tracking-tight sm:text-4xl">
        {t.blog.lead}
      </h1>
    </header>

    {
      posts.length === 0 ? (
        <p class="mt-12 text-muted" data-reveal>
          {t.blog.noArticles}
        </p>
      ) : (
        /* Ogni card ha il proprio data-reveal con delay crescente
           così appaiono in sequenza anziché tutte insieme. */
        <div class="mt-12 grid gap-6 sm:grid-cols-2">
          {posts.map((post, i) => (
            <div
              data-reveal
              data-reveal-delay={i > 0 ? String(Math.min(i, 3)) : undefined}
            >
              <PostCard {...post} lang={lang} />
            </div>
          ))}
        </div>
      )
    }
  </div>
</section>
