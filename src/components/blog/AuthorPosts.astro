---
import type { Lang } from "../../i18n/ui";
import { useTranslations } from "../../i18n/utils";
import { getPublishedPosts, processPosts } from "../../utils/blog";
import PostCard from "./PostCard.astro";

interface Props {
  authorKey: string;
  authorName: string;
  lang: Lang;
}

const { authorKey, authorName, lang } = Astro.props;
const t = useTranslations(lang);

const allPosts = await getPublishedPosts(lang);
const posts = allPosts.filter((p) => p.data.authors.includes(authorKey));
const processedPosts = await processPosts(posts, lang);
---

{
  processedPosts.length > 0 && (
    <section class="py-20 md:py-24 border-t border-border">
      <div class="mx-auto max-w-5xl px-6">
        <header data-reveal>
          <p class="text-sm font-semibold uppercase tracking-widest text-accent">
            {lang === "it" ? "Articoli" : "Articles"}
          </p>
          <h2 class="mt-2 text-3xl font-bold tracking-tight sm:text-4xl">
            {t.blog.authorPostsHeading(authorName)}
          </h2>
        </header>

        <div class="mt-12 grid gap-6 sm:grid-cols-2">
          {processedPosts.map((post, i) => (
            <div
              data-reveal
              data-reveal-delay={i > 0 ? String(Math.min(i, 3)) : undefined}
            >
              <PostCard {...post} lang={lang} />
            </div>
          ))}
        </div>
      </div>
    </section>
  )
}
