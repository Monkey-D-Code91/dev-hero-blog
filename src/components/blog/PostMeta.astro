---
import type { Lang } from "../../i18n/ui";
import TagPill from "./TagPill.astro";
import { formatDate } from "../../utils/blog";

interface Props {
  pubDate: Date;
  updatedDate?: Date;
  readingTime: string;
  tags: string[];
  lang: Lang;
}

const { pubDate, updatedDate, readingTime, tags, lang } = Astro.props;
const published = formatDate(pubDate, lang);
const updated = updatedDate ? formatDate(updatedDate, lang) : null;
const publishedLabel = lang === "it" ? "Pubblicato il" : "Published on";
const updatedLabel = lang === "it" ? "Aggiornato il" : "Updated on";
const readingTimeLabel = lang === "it" ? "Tempo di lettura:" : "Reading time:";
const tagsLabel = lang === "it" ? "Tag:" : "Tags:";
---

<div class="flex flex-wrap items-center gap-x-3 gap-y-2 text-sm text-muted">
  <!-- Data di pubblicazione -->
  <span class="flex items-center gap-1.5">
    <svg
      width="14"
      height="14"
      viewBox="0 0 24 24"
      fill="none"
      stroke="currentColor"
      stroke-width="2"
      stroke-linecap="round"
      stroke-linejoin="round"
      aria-hidden="true"
    >
      <rect x="3" y="4" width="18" height="18" rx="2" ry="2"></rect>
      <line x1="16" y1="2" x2="16" y2="6"></line>
      <line x1="8" y1="2" x2="8" y2="6"></line>
      <line x1="3" y1="10" x2="21" y2="10"></line>
    </svg>
    <span class="sr-only">{publishedLabel}</span>
    <time datetime={pubDate.toISOString()}>{published}</time>
  </span>

  {
    updated && (
      <>
        <span class="opacity-40" aria-hidden="true">·</span>
        <span class="flex items-center gap-1.5">
          <svg
            width="14"
            height="14"
            viewBox="0 0 24 24"
            fill="none"
            stroke="currentColor"
            stroke-width="2"
            stroke-linecap="round"
            stroke-linejoin="round"
            aria-hidden="true"
          >
            <polyline points="23 4 23 10 17 10" />
            <path d="M20.49 15a9 9 0 1 1-2.12-9.36L23 10" />
          </svg>
          <span class="sr-only">{updatedLabel}</span>
          <time datetime={updatedDate!.toISOString()}>{updated}</time>
        </span>
      </>
    )
  }

  <!-- Tempo di lettura -->
  {
    readingTime && (
      <>
        <span class="opacity-40" aria-hidden="true">·</span>
        <span class="flex items-center gap-1.5">
          <svg
            width="14"
            height="14"
            viewBox="0 0 24 24"
            fill="none"
            stroke="currentColor"
            stroke-width="2"
            stroke-linecap="round"
            stroke-linejoin="round"
            aria-hidden="true"
          >
            <circle cx="12" cy="12" r="10" />
            <polyline points="12 6 12 12 16 14" />
          </svg>
          <span class="sr-only">{readingTimeLabel}</span>
          {readingTime}
        </span>
      </>
    )
  }

  <!-- Tag (link all'archivio) -->
  {
    tags.length > 0 && (
      <>
        <span class="opacity-40" aria-hidden="true">·</span>
        <div class="flex flex-wrap gap-1.5" aria-label={tagsLabel}>
          {tags.map((tag) => (
            <TagPill tag={tag} lang={lang} link={true} />
          ))}
        </div>
      </>
    )
  }
</div>
