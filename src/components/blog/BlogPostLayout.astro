---
import { Image } from "astro:assets";
import type { ImageMetadata } from "astro";
import type { Lang } from "../../i18n/ui";
import type { PostAuthor } from "../../utils/blog";
import { getLangFromUrl, useTranslations } from "../../i18n/utils";
import PostMeta from "./PostMeta.astro";
import AuthorCard from "./AuthorCard.astro";
import RelatedPosts from "./RelatedPosts.astro";
import ShareButtons from "./ShareButtons.astro";
import Comments from "./Comments.astro";
import type { ProcessedPost } from "../../utils/blog";

interface Props {
  title: string;
  description: string;
  pubDate: Date;
  updatedDate?: Date;
  tags: string[];
  readingTime: string;
  cover?: ImageMetadata;
  coverAlt?: string;
  authors: PostAuthor[];
  related?: ProcessedPost[];
  url: string;
}

const {
  title,
  description: _description,
  pubDate,
  updatedDate,
  tags,
  readingTime,
  cover,
  coverAlt,
  authors,
  related = [],
  url,
} = Astro.props;

const lang = getLangFromUrl(Astro.url);
const t = useTranslations(lang);

const backUrl = lang === "it" ? "/blog/" : "/en/blog/";
const backLabel = t.blog.backToBlog;
---

<!-- Colonna a misura di lettura: ~68–72 caratteri per riga col corpo a 19px -->
<div class="mx-auto max-w-2xl px-6 py-14 md:py-20">
  <!-- Link "torna al blog" (sopra) -->
  <a
    href={backUrl}
    class="mb-10 inline-flex items-center gap-2 text-sm text-muted transition-colors hover:text-accent"
  >
    <svg
      width="16"
      height="16"
      viewBox="0 0 24 24"
      fill="none"
      stroke="currentColor"
      stroke-width="2"
      stroke-linecap="round"
      stroke-linejoin="round"
      aria-hidden="true"
    >
      <line x1="19" y1="12" x2="5" y2="12"></line>
      <polyline points="12 19 5 12 12 5"></polyline>
    </svg>
    {backLabel}
  </a>

  <!-- Landmark article con titolo collegato via aria-labelledby -->
  <article aria-labelledby="article-title">
    <!-- Header articolo -->
    <header class="mb-8">
      <p class="mb-3 text-sm font-semibold uppercase tracking-widest text-accent">
        {t.blog.heading}
      </p>
      <h1
        id="article-title"
        class="text-3xl font-bold leading-tight tracking-tight sm:text-4xl text-text"
      >
        {title}
      </h1>
      <div class="mt-5">
        <PostMeta
          pubDate={pubDate}
          updatedDate={updatedDate}
          readingTime={readingTime}
          tags={tags}
          lang={lang}
          authors={authors}
        />
      </div>
    </header>

    <!-- Cover image -->
    {
      cover && (
        <div class="mb-10 overflow-hidden rounded-2xl border border-border">
          <Image
            src={cover}
            alt={coverAlt ?? ""}
            width={896}
            height={468}
            loading="eager"
            fetchpriority="high"
            class="w-full h-auto"
          />
        </div>
      )
    }

    <!-- Contenuto Markdown/MDX in stile prose -->
    <div class="prose prose-dark max-w-none">
      <slot />
    </div>
  </article>

  <!-- Link "torna al blog" + bottoni di condivisione (sotto) -->
  <div class="mt-14 border-t border-border pt-8 flex flex-wrap items-center justify-between gap-4">
    <a
      href={backUrl}
      class="inline-flex items-center gap-2 text-sm text-muted transition-colors hover:text-accent"
    >
      <svg
        width="16"
        height="16"
        viewBox="0 0 24 24"
        fill="none"
        stroke="currentColor"
        stroke-width="2"
        stroke-linecap="round"
        stroke-linejoin="round"
        aria-hidden="true"
      >
        <line x1="19" y1="12" x2="5" y2="12"></line>
        <polyline points="12 19 5 12 12 5"></polyline>
      </svg>
      {backLabel}
    </a>
    <ShareButtons url={url} title={title} lang={lang} />
  </div>

  <!-- Articoli correlati -->
  <RelatedPosts posts={related} lang={lang} />

  <!-- Card autore/i (visibilità di chi ha scritto il pezzo) -->
  <section
    class="mt-16 border-t border-border pt-12"
    aria-labelledby="author-card-heading"
  >
    <p
      id="author-card-heading"
      class="text-sm font-semibold uppercase tracking-widest text-accent"
    >
      {authors.length > 1 ? t.blog.authorsCardHeading : t.blog.authorCardHeading}
    </p>
    <div class="mt-6 flex flex-col gap-5">
      {authors.map((author) => <AuthorCard authorKey={author.key} lang={lang} />)}
    </div>
  </section>

  <!-- Commenti -->
  <Comments />
</div>
