---
// Serif editoriale solo per l'esperienza di lettura articolo (vedi docs/brand.md).
// L'import qui (e non in BaseLayout) evita di caricare il font sulle altre pagine.
import "@fontsource-variable/newsreader";
import "@fontsource-variable/newsreader/wght-italic.css";
import { Image } from "astro:assets";
import type { ImageMetadata } from "astro";
import type { Lang } from "../../i18n/ui";
import type { BlogFocus, PostAuthor } from "../../utils/blog";
import { getLangFromUrl, useTranslations } from "../../i18n/utils";
import FocusTriad from "./FocusTriad.astro";
import PostMeta from "./PostMeta.astro";
import AuthorCard from "./AuthorCard.astro";
import RelatedPosts from "./RelatedPosts.astro";
import ShareButtons from "./ShareButtons.astro";
import Comments from "./Comments.astro";
import DiscussionTable from "./DiscussionTable.astro";
import type { DiscussionEntry } from "./DiscussionTable.astro";
import RevisionHistory from "./RevisionHistory.astro";
import type { Revision } from "./RevisionHistory.astro";
import Contradiction from "./Contradiction.astro";
import type { Contradictions } from "../../utils/contradictions";
import FeedbackNote from "./FeedbackNote.astro";
import NewsletterSignup from "../NewsletterSignup.astro";
import { newsletterEnabled } from "../../config";
import type { ProcessedPost } from "../../utils/blog";

interface Props {
  title: string;
  description: string;
  pubDate: Date;
  updatedDate?: Date;
  tags: string[];
  focus?: BlogFocus[];
  readingTime: string;
  cover?: ImageMetadata;
  coverAlt?: string;
  authors: PostAuthor[];
  related?: ProcessedPost[];
  discussion?: DiscussionEntry[];
  revisions?: Revision[];
  contradictions?: Contradictions;
  feedbackReviewed?: boolean;
  url: string;
}

const {
  title,
  description: _description,
  pubDate,
  updatedDate,
  tags,
  focus = [],
  readingTime,
  cover,
  coverAlt,
  authors,
  related = [],
  discussion = [],
  revisions = [],
  contradictions = { respondedBy: [] },
  feedbackReviewed = false,
  url,
} = Astro.props;

const lang = getLangFromUrl(Astro.url);
const t = useTranslations(lang);

const backUrl = lang === "it" ? "/blog/" : "/en/blog/";
const backLabel = t.blog.backToBlog;
const rssUrl = lang === "it" ? "/rss.xml" : "/en/rss.xml";
---

<!-- Barra di progresso lettura (riempita dallo script in fondo) -->
<div class="reading-progress" aria-hidden="true">
  <div class="reading-progress__fill" data-reading-progress></div>
</div>

<!-- Colonna a misura di lettura: ~68–72 caratteri per riga col corpo a 19px -->
<div class="mx-auto max-w-2xl px-6 py-14 md:py-20">
  <!-- Link "torna al blog" (sopra) -->
  <a
    href={backUrl}
    class="mb-10 inline-flex items-center gap-2 text-sm text-muted transition-colors hover:text-accent"
  >
    <svg
      width="16"
      height="16"
      viewBox="0 0 24 24"
      fill="none"
      stroke="currentColor"
      stroke-width="2"
      stroke-linecap="round"
      stroke-linejoin="round"
      aria-hidden="true"
    >
      <line x1="19" y1="12" x2="5" y2="12"></line>
      <polyline points="12 19 5 12 12 5"></polyline>
    </svg>
    {backLabel}
  </a>

  <!--
    Landmark article con titolo collegato via aria-labelledby.
    data-pagefind-body scopa l'indice di ricerca a questo solo contenuto: una volta
    presente su una pagina del sito, Pagefind indicizza SOLO le pagine che portano
    questo attributo (vedi TECH-IMPROVEMENTS.md #9). Homepage, roadmap, autori e
    domande aperte restano fuori di conseguenza, senza bisogno di escluderle a mano.
  -->
  <article aria-labelledby="article-title" data-pagefind-body>
    <!-- Header articolo -->
    <header class="mb-8">
      <div class="mb-3 flex items-center justify-between gap-4">
        <p class="text-sm font-semibold uppercase tracking-widest text-accent">
          {t.blog.heading}
        </p>
        <FocusTriad focus={focus} lang={lang} size="md" showLabels />
      </div>
      <h1
        id="article-title"
        class="font-serif text-4xl font-semibold leading-tight tracking-tight sm:text-[2.75rem] text-text"
      >
        {title}
      </h1>
      <div class="mt-5">
        <PostMeta
          pubDate={pubDate}
          updatedDate={updatedDate}
          readingTime={readingTime}
          tags={tags}
          lang={lang}
          authors={authors}
        />
      </div>
    </header>

    <!-- Cover image -->
    {
      cover && (
        <div class="mb-10 overflow-hidden rounded-2xl border border-border">
          <Image
            src={cover}
            alt={coverAlt ?? ""}
            width={896}
            height={468}
            loading="eager"
            fetchpriority="high"
            class="w-full h-auto"
          />
        </div>
      )
    }

    <!-- Contraddizione: se il pezzo risponde a un altro, lo si dichiara prima -->
    <Contradiction
      direction="responds"
      links={contradictions.respondsTo ? [contradictions.respondsTo] : []}
      lang={lang}
    />

    <!-- Contenuto Markdown/MDX in stile prose -->
    <div class="prose prose-dark max-w-none">
      <slot />
    </div>

    <!-- Storia delle revisioni: le bozze successive del pezzo -->
    <RevisionHistory revisions={revisions} lang={lang} />

    <!-- "Dal tavolo di discussione": scambi tornati nel pezzo dopo l'uscita -->
    <DiscussionTable entries={discussion} lang={lang} />

    <!-- Contraddizione: i pezzi che rispondono a questo (dialogo che continua) -->
    <Contradiction
      direction="responded"
      links={contradictions.respondedBy}
      lang={lang}
    />

    <!-- Nota di processo: il pezzo è passato dal gruppo di feedback -->
    <FeedbackNote reviewed={feedbackReviewed} lang={lang} />
  </article>

  <!-- Link "torna al blog" + bottoni di condivisione (sotto) -->
  <div class="mt-14 border-t border-border pt-8 flex flex-wrap items-center justify-between gap-4">
    <a
      href={backUrl}
      class="inline-flex items-center gap-2 text-sm text-muted transition-colors hover:text-accent"
    >
      <svg
        width="16"
        height="16"
        viewBox="0 0 24 24"
        fill="none"
        stroke="currentColor"
        stroke-width="2"
        stroke-linecap="round"
        stroke-linejoin="round"
        aria-hidden="true"
      >
        <line x1="19" y1="12" x2="5" y2="12"></line>
        <polyline points="12 19 5 12 12 5"></polyline>
      </svg>
      {backLabel}
    </a>
    <ShareButtons url={url} title={title} lang={lang} />
  </div>

  <!-- Fine lettura: newsletter (canale proprietario) se attiva, altrimenti RSS -->
  {
    newsletterEnabled ? (
      <div class="mt-8">
        <p class="text-sm text-muted">{t.newsletter.articleCtaText}</p>
        <div class="mt-4">
          <NewsletterSignup lang={lang} compact />
        </div>
        <p class="mt-3 text-xs text-muted/70">
          {t.newsletter.articleCtaOrRss}
          <a
            href={rssUrl}
            class="ml-1 font-medium text-accent transition-colors hover:text-accent-2"
          >
            {t.blog.rssCtaLabel}
          </a>
        </p>
      </div>
    ) : (
      <p class="mt-8 text-sm text-muted">
        {t.blog.rssCtaText}
        <a
          href={rssUrl}
          class="ml-1 font-medium text-accent transition-colors hover:text-accent-2"
        >
          {t.blog.rssCtaLabel}
        </a>
      </p>
    )
  }

  <!-- Articoli correlati -->
  <RelatedPosts posts={related} lang={lang} />

  <!-- Card autore/i (visibilità di chi ha scritto il pezzo) -->
  <section
    class="mt-16 border-t border-border pt-12"
    aria-labelledby="author-card-heading"
  >
    <p
      id="author-card-heading"
      class="text-sm font-semibold uppercase tracking-widest text-accent"
    >
      {authors.length > 1 ? t.blog.authorsCardHeading : t.blog.authorCardHeading}
    </p>
    <div class="mt-6 flex flex-col gap-5">
      {authors.map((author) => <AuthorCard authorKey={author.key} lang={lang} />)}
    </div>
  </section>

  <!-- Commenti -->
  <Comments />
</div>

<script>
  // Progresso di lettura: scaleX in base allo scroll, aggiornato via rAF.
  const fill = document.querySelector<HTMLElement>("[data-reading-progress]");
  if (fill) {
    let ticking = false;
    const update = () => {
      const max = document.documentElement.scrollHeight - window.innerHeight;
      const ratio = max > 0 ? Math.min(window.scrollY / max, 1) : 0;
      fill.style.transform = `scaleX(${ratio})`;
      ticking = false;
    };
    const onScroll = () => {
      if (!ticking) {
        ticking = true;
        requestAnimationFrame(update);
      }
    };
    window.addEventListener("scroll", onScroll, { passive: true });
    window.addEventListener("resize", onScroll, { passive: true });
    update();
  }
</script>
