---
import type { ProcessedPost } from "../../../utils/blog";
import { getPublishedPosts, processPosts } from "../../../utils/blog";
import BaseLayout from "../../../layouts/BaseLayout.astro";
import Navbar from "../../../components/Navbar.astro";
import Footer from "../../../components/Footer.astro";
import PostCard from "../../../components/blog/PostCard.astro";
import TagFilterBar from "../../../components/blog/TagFilterBar.astro";
import { BLOG } from "../../../config";

export async function getStaticPaths() {
  const lang = "it" as const;
  const allPosts = await getPublishedPosts(lang);

  // Costruisce la mappa tag → articoli
  const tagMap = new Map<string, typeof allPosts>();
  for (const post of allPosts) {
    for (const tag of post.data.tags) {
      if (!tagMap.has(tag)) tagMap.set(tag, []);
      tagMap.get(tag)!.push(post);
    }
  }

  return Promise.all(
    [...tagMap.entries()].map(async ([tag, tagPosts]) => ({
      params: { tag },
      props: { tag, posts: await processPosts(tagPosts, lang) },
    }))
  );
}

interface Props {
  tag: string;
  posts: ProcessedPost[];
}

const { tag, posts } = Astro.props;
const lang = "it" as const;

const pageTitle = `#${tag} · Blog · ${BLOG.name}`;
const pageDescription = `Tutti gli articoli di ${BLOG.name} con il tag "${tag}".`;
const articleCount =
  posts.length === 1 ? "1 articolo" : `${posts.length} articoli`;
---

<BaseLayout
  title={pageTitle}
  description={pageDescription}
  lang="it"
  path={`/blog/tag/${tag}/`}
  hreflangIt={`/blog/tag/${tag}/`}
  hreflangEn="/en/blog/"
>
  <Navbar itHref={`/blog/tag/${tag}/`} enHref="/en/blog/" />
  <main id="main" tabindex="-1">
    <section class="py-20 md:py-24">
      <div class="mx-auto max-w-5xl px-6">
        <!-- Link "tutti gli articoli" -->
        <a
          href="/blog/"
          class="inline-flex items-center gap-2 text-sm text-muted transition-colors hover:text-accent"
        >
          <svg
            width="16"
            height="16"
            viewBox="0 0 24 24"
            fill="none"
            stroke="currentColor"
            stroke-width="2"
            stroke-linecap="round"
            stroke-linejoin="round"
            aria-hidden="true"
          >
            <line x1="19" y1="12" x2="5" y2="12"></line>
            <polyline points="12 19 5 12 12 5"></polyline>
          </svg>
          Tutti gli articoli
        </a>

        <!-- Intestazione tag -->
        <header class="mt-10" data-reveal>
          <p class="text-sm font-semibold uppercase tracking-widest text-accent">
            Tag
          </p>
          <h1 class="mt-2 text-3xl font-bold tracking-tight sm:text-4xl">
            <span class="text-muted">#</span>{tag}
          </h1>
          <p class="mt-2 text-muted">{articleCount}</p>
          <div class="mt-8">
            <TagFilterBar lang={lang} activeTag={tag} />
          </div>
        </header>

        <!-- Griglia articoli — reveal staggered per card -->
        <div class="mt-12 grid gap-6 sm:grid-cols-2">
          {posts.map((post, i) => (
            <div
              data-reveal
              data-reveal-delay={i > 0 ? String(Math.min(i, 3)) : undefined}
            >
              <PostCard {...post} lang={lang} />
            </div>
          ))}
        </div>
      </div>
    </section>
  </main>
  <Footer />
</BaseLayout>
