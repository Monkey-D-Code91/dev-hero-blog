---
import type { CollectionEntry } from "astro:content";
import { render } from "astro:content";
import BaseLayout from "../../layouts/BaseLayout.astro";
import Navbar from "../../components/Navbar.astro";
import BlogPostLayout from "../../components/blog/BlogPostLayout.astro";
import Footer from "../../components/Footer.astro";
import {
  getPublishedPosts,
  getAlternatePost,
  getSlugFromEntryId,
  getBlogPostUrl,
  getAuthorUrl,
  findAuthors,
  getRelatedPosts,
} from "../../utils/blog";
import { getReadingTime } from "../../utils/readingTime";
import { buildArticleSchema } from "../../utils/structuredData";

export async function getStaticPaths() {
  const posts = await getPublishedPosts("it");
  return posts.map((post) => ({
    params: { slug: getSlugFromEntryId(post.id) },
    props: { post },
  }));
}

interface Props {
  post: CollectionEntry<"blog">;
}

const { post } = Astro.props;
const { Content } = await render(post);

const lang = "it" as const;
const slug = getSlugFromEntryId(post.id);
const readingTime = getReadingTime(post.body, lang);

// Trova la traduzione EN per hreflang
const altPost = await getAlternatePost(post.data.translationKey, "en");
const hreflangEn = altPost
  ? getBlogPostUrl("en", getSlugFromEntryId(altPost.id))
  : "/en/blog/";

// Autori (uno o più). Risolve nome, monogramma e avatar dai profili.
const authorEntries = await findAuthors(post.data.authors, lang);
const authors = post.data.authors.map((key) => {
  const entry = authorEntries.find((a) => a.data.authorKey === key);
  return {
    key,
    name: entry?.data.name ?? key,
    monogram: entry?.data.monogram ?? key.slice(0, 2).toUpperCase(),
    avatar: entry?.data.avatar,
    avatarAlt: entry?.data.avatarAlt,
  };
});

// Articoli correlati (per tag + autori comuni).
const related = await getRelatedPosts(post, lang);

// OG image: preferisci la cover dell'articolo come anteprima social,
// con fallback all'OG generata per-articolo (titolo + autore/i).
const generatedOg = new URL(`/og/${post.id}.png`, Astro.site).toString();
const ogImage = post.data.cover
  ? new URL(post.data.cover.src, Astro.site).toString()
  : generatedOg;

// JSON-LD BlogPosting — stessa immagine usata per l'OG (cover se presente).
const imageUrl = ogImage;
// Se c'è un canonicalUrl esterno, il JSON-LD punta a quello come url/mainEntityOfPage.
const effectiveCanonical = post.data.canonicalUrl ?? `/blog/${slug}/`;
const articleSchema = buildArticleSchema({
  site: Astro.site,
  lang,
  title: post.data.title,
  description: post.data.description,
  canonicalPath: effectiveCanonical,
  pubDate: post.data.pubDate,
  updatedDate: post.data.updatedDate,
  tags: post.data.tags,
  imageUrl,
  authors: post.data.authors.map((key) => {
    const entry = authorEntries.find((a) => a.data.authorKey === key);
    return {
      name: entry?.data.name ?? key,
      path: getAuthorUrl(key, lang),
      sameAs: entry
        ? (Object.values(entry.data.links).filter(Boolean) as string[])
        : [],
    };
  }),
});
---

<BaseLayout
  title={post.data.title}
  description={post.data.description}
  lang="it"
  path={`/blog/${slug}/`}
  ogType="article"
  ogImage={ogImage}
  hreflangIt={`/blog/${slug}/`}
  hreflangEn={hreflangEn}
  jsonLd={articleSchema}
  canonicalUrl={post.data.canonicalUrl}
>
  <Navbar itHref={`/blog/${slug}/`} enHref={hreflangEn} />
  <main id="main" tabindex="-1">
    <BlogPostLayout
      title={post.data.title}
      description={post.data.description}
      pubDate={post.data.pubDate}
      updatedDate={post.data.updatedDate}
      tags={post.data.tags}
      focus={post.data.focus}
      readingTime={readingTime}
      cover={post.data.cover}
      coverAlt={post.data.coverAlt}
      authors={authors}
      related={related}
      discussion={post.data.discussion}
      url={new URL(`/blog/${slug}/`, Astro.site).toString()}
    >
      <Content />
    </BlogPostLayout>
  </main>
  <Footer />
</BaseLayout>
