---
import type { CollectionEntry } from "astro:content";
import { render } from "astro:content";
import BaseLayout from "../../layouts/BaseLayout.astro";
import Navbar from "../../components/Navbar.astro";
import BlogPostLayout from "../../components/blog/BlogPostLayout.astro";
import Footer from "../../components/Footer.astro";
import {
  getPublishedPosts,
  getAlternatePost,
  getSlugFromEntryId,
  getBlogPostUrl,
  getAuthorUrl,
  findAuthor,
} from "../../utils/blog";
import { getReadingTime } from "../../utils/readingTime";
import { buildArticleSchema } from "../../utils/structuredData";

export async function getStaticPaths() {
  const posts = await getPublishedPosts("it");
  return posts.map((post) => ({
    params: { slug: getSlugFromEntryId(post.id) },
    props: { post },
  }));
}

interface Props {
  post: CollectionEntry<"blog">;
}

const { post } = Astro.props;
const { Content } = await render(post);

const lang = "it" as const;
const slug = getSlugFromEntryId(post.id);
const readingTime = getReadingTime(post.body, lang);

// Trova la traduzione EN per hreflang
const altPost = await getAlternatePost(post.data.translationKey, "en");
const hreflangEn = altPost
  ? getBlogPostUrl("en", getSlugFromEntryId(altPost.id))
  : "/en/blog/";

// Autore
const authorKey = post.data.author;
const author = await findAuthor(authorKey, lang);
const authorName = author?.data.name ?? authorKey;
const authorSameAs = author
  ? (Object.values(author.data.links).filter(Boolean) as string[])
  : [];

// OG image generata per-articolo (titolo + autore).
const ogImage = new URL(`/og/${post.id}.png`, Astro.site).toString();

// JSON-LD BlogPosting — usa la cover se presente, altrimenti l'OG generata.
const imageUrl = post.data.cover
  ? new URL(post.data.cover.src, Astro.site).toString()
  : ogImage;
const articleSchema = buildArticleSchema({
  site: Astro.site,
  lang,
  title: post.data.title,
  description: post.data.description,
  canonicalPath: `/blog/${slug}/`,
  pubDate: post.data.pubDate,
  updatedDate: post.data.updatedDate,
  tags: post.data.tags,
  imageUrl,
  authorName,
  authorPath: getAuthorUrl(authorKey, lang),
  authorSameAs,
});
---

<BaseLayout
  title={post.data.title}
  description={post.data.description}
  lang="it"
  path={`/blog/${slug}/`}
  ogType="article"
  ogImage={ogImage}
  hreflangIt={`/blog/${slug}/`}
  hreflangEn={hreflangEn}
  jsonLd={articleSchema}
>
  <Navbar itHref={`/blog/${slug}/`} enHref={hreflangEn} />
  <main id="main">
    <BlogPostLayout
      title={post.data.title}
      description={post.data.description}
      pubDate={post.data.pubDate}
      updatedDate={post.data.updatedDate}
      tags={post.data.tags}
      readingTime={readingTime}
      cover={post.data.cover}
      coverAlt={post.data.coverAlt}
      authorKey={authorKey}
      authorName={authorName}
    >
      <Content />
    </BlogPostLayout>
  </main>
  <Footer />
</BaseLayout>
