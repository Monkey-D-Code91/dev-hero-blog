---
import type { CollectionEntry } from "astro:content";
import { render } from "astro:content";
import BaseLayout from "../../layouts/BaseLayout.astro";
import Navbar from "../../components/Navbar.astro";
import BlogPostLayout from "../../components/blog/BlogPostLayout.astro";
import Footer from "../../components/Footer.astro";
import {
  getPublishedPosts,
  getAlternatePost,
  getSlugFromEntryId,
  getBlogPostUrl,
} from "../../utils/blog";
import { getReadingTime } from "../../utils/readingTime";

export async function getStaticPaths() {
  const posts = await getPublishedPosts("it");
  return posts.map((post) => ({
    params: { slug: getSlugFromEntryId(post.id) },
    props: { post },
  }));
}

interface Props {
  post: CollectionEntry<"blog">;
}

const { post } = Astro.props;
const { Content } = await render(post);

const lang = "it" as const;
const slug = getSlugFromEntryId(post.id);
const readingTime = getReadingTime(post.body, lang);

// Trova la traduzione EN per hreflang
const altPost = await getAlternatePost(post.data.translationKey, "en");
const hreflangEn = altPost
  ? getBlogPostUrl("en", getSlugFromEntryId(altPost.id))
  : "/en/blog/";

// OG image: usa la cover dell'articolo se disponibile, altrimenti quella di default
const ogImage = post.data.cover
  ? undefined // verrà usato il default (non abbiamo ancora un URL assoluto per la cover)
  : undefined;
---

<BaseLayout
  title={post.data.title}
  description={post.data.description}
  lang="it"
  path={`/blog/${slug}/`}
  ogType="article"
  hreflangIt={`/blog/${slug}/`}
  hreflangEn={hreflangEn}
>
  <Navbar />
  <main id="main">
    <BlogPostLayout
      title={post.data.title}
      description={post.data.description}
      pubDate={post.data.pubDate}
      updatedDate={post.data.updatedDate}
      tags={post.data.tags}
      readingTime={readingTime}
      cover={post.data.cover}
      coverAlt={post.data.coverAlt}
    >
      <Content />
    </BlogPostLayout>
  </main>
  <Footer />
</BaseLayout>
