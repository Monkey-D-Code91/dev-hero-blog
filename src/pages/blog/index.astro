---
import BaseLayout from "../../layouts/BaseLayout.astro";
import Navbar from "../../components/Navbar.astro";
import BlogList from "../../components/blog/BlogList.astro";
import Footer from "../../components/Footer.astro";
import { getPublishedPosts, processPosts } from "../../utils/blog";
import { useTranslations } from "../../i18n/utils";

const lang = "it" as const;
const t = useTranslations(lang);

const processedPosts = await processPosts(await getPublishedPosts(lang), lang);
---

<BaseLayout
  title={`Blog — Marco Mariotti`}
  description={t.blog.lead}
  lang="it"
  path="/blog/"
  hreflangIt="/blog/"
  hreflangEn="/en/blog/"
>
  <Navbar itHref="/blog/" enHref="/en/blog/" />
  <main id="main">
    <BlogList posts={processedPosts} />
  </main>
  <Footer />
</BaseLayout>
