---
import type { CollectionEntry } from "astro:content";
import { render } from "astro:content";
import BaseLayout from "../../../layouts/BaseLayout.astro";
import Navbar from "../../../components/Navbar.astro";
import BlogPostLayout from "../../../components/blog/BlogPostLayout.astro";
import Footer from "../../../components/Footer.astro";
import {
  getPublishedPosts,
  getAlternatePost,
  getSlugFromEntryId,
  getBlogPostUrl,
  getAuthorUrl,
  findAuthors,
} from "../../../utils/blog";
import { getReadingTime } from "../../../utils/readingTime";
import { buildArticleSchema } from "../../../utils/structuredData";

export async function getStaticPaths() {
  const posts = await getPublishedPosts("en");
  return posts.map((post) => ({
    params: { slug: getSlugFromEntryId(post.id) },
    props: { post },
  }));
}

interface Props {
  post: CollectionEntry<"blog">;
}

const { post } = Astro.props;
const { Content } = await render(post);

const lang = "en" as const;
const slug = getSlugFromEntryId(post.id);
const readingTime = getReadingTime(post.body, lang);

// Trova la traduzione IT per hreflang
const altPost = await getAlternatePost(post.data.translationKey, "it");
const hreflangIt = altPost
  ? getBlogPostUrl("it", getSlugFromEntryId(altPost.id))
  : "/blog/";

// Autori (uno o più). Risolve nome + link dai profili.
const authorEntries = await findAuthors(post.data.authors, lang);
const authors = post.data.authors.map((key) => {
  const entry = authorEntries.find((a) => a.data.authorKey === key);
  return { key, name: entry?.data.name ?? key };
});

// OG image generata per-articolo (titolo + autore/i).
const ogImage = new URL(`/og/${post.id}.png`, Astro.site).toString();

// JSON-LD BlogPosting — usa la cover se presente, altrimenti l'OG generata.
const imageUrl = post.data.cover
  ? new URL(post.data.cover.src, Astro.site).toString()
  : ogImage;
const articleSchema = buildArticleSchema({
  site: Astro.site,
  lang,
  title: post.data.title,
  description: post.data.description,
  canonicalPath: `/en/blog/${slug}/`,
  pubDate: post.data.pubDate,
  updatedDate: post.data.updatedDate,
  tags: post.data.tags,
  imageUrl,
  authors: post.data.authors.map((key) => {
    const entry = authorEntries.find((a) => a.data.authorKey === key);
    return {
      name: entry?.data.name ?? key,
      path: getAuthorUrl(key, lang),
      sameAs: entry
        ? (Object.values(entry.data.links).filter(Boolean) as string[])
        : [],
    };
  }),
});
---

<BaseLayout
  title={post.data.title}
  description={post.data.description}
  lang="en"
  path={`/en/blog/${slug}/`}
  ogType="article"
  ogImage={ogImage}
  hreflangIt={hreflangIt}
  hreflangEn={`/en/blog/${slug}/`}
  jsonLd={articleSchema}
>
  <Navbar itHref={hreflangIt} enHref={`/en/blog/${slug}/`} />
  <main id="main">
    <BlogPostLayout
      title={post.data.title}
      description={post.data.description}
      pubDate={post.data.pubDate}
      updatedDate={post.data.updatedDate}
      tags={post.data.tags}
      readingTime={readingTime}
      cover={post.data.cover}
      coverAlt={post.data.coverAlt}
      authors={authors}
    >
      <Content />
    </BlogPostLayout>
  </main>
  <Footer />
</BaseLayout>
