---
import type { CollectionEntry } from "astro:content";
import { render } from "astro:content";
import BaseLayout from "../../../layouts/BaseLayout.astro";
import Navbar from "../../../components/Navbar.astro";
import BlogPostLayout from "../../../components/blog/BlogPostLayout.astro";
import Footer from "../../../components/Footer.astro";
import {
  getPublishedPosts,
  getAlternatePost,
  getSlugFromEntryId,
  getBlogPostUrl,
  buildAuthorNameMap,
} from "../../../utils/blog";
import { getReadingTime } from "../../../utils/readingTime";

export async function getStaticPaths() {
  const posts = await getPublishedPosts("en");
  return posts.map((post) => ({
    params: { slug: getSlugFromEntryId(post.id) },
    props: { post },
  }));
}

interface Props {
  post: CollectionEntry<"blog">;
}

const { post } = Astro.props;
const { Content } = await render(post);

const lang = "en" as const;
const slug = getSlugFromEntryId(post.id);
const readingTime = getReadingTime(post.body, lang);

// Trova la traduzione IT per hreflang
const altPost = await getAlternatePost(post.data.translationKey, "it");
const hreflangIt = altPost
  ? getBlogPostUrl("it", getSlugFromEntryId(altPost.id))
  : "/blog/";

// Autore
const authorMap = await buildAuthorNameMap(lang);
const authorKey = post.data.author;
const authorName = authorMap.get(authorKey) ?? authorKey;
---

<BaseLayout
  title={post.data.title}
  description={post.data.description}
  lang="en"
  path={`/en/blog/${slug}/`}
  ogType="article"
  hreflangIt={hreflangIt}
  hreflangEn={`/en/blog/${slug}/`}
>
  <Navbar itHref={hreflangIt} enHref={`/en/blog/${slug}/`} showSections={false} />
  <main id="main">
    <BlogPostLayout
      title={post.data.title}
      description={post.data.description}
      pubDate={post.data.pubDate}
      updatedDate={post.data.updatedDate}
      tags={post.data.tags}
      readingTime={readingTime}
      cover={post.data.cover}
      coverAlt={post.data.coverAlt}
      authorKey={authorKey}
      authorName={authorName}
    >
      <Content />
    </BlogPostLayout>
  </main>
  <Footer />
</BaseLayout>
