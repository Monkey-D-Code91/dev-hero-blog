---
/**
 * Homepage EN — temporaneamente mostra il profilo di Marco Mariotti.
 * Sarà sostituita dalla landing del blog in Fase C2.
 */
import { getCollection, render } from "astro:content";
import AuthorLayout from "../../layouts/AuthorLayout.astro";

// Carica il profilo EN di Marco dalla collection authors.
const allAuthors = await getCollection("authors");
const entry = allAuthors.find((a) => a.id === "en/marco-mariotti");
if (!entry) throw new Error("Author en/marco-mariotti not found in collection");

const { Content } = await render(entry);
const author = entry.data;
---

<AuthorLayout
  author={author}
  lang="en"
  itHref="/"
  enHref="/en/"
  title="Marco Mariotti — Software Engineer & Tech Lead"
  description={author.subline}
>
  <Content />
</AuthorLayout>
