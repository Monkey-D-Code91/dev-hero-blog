---
import BaseLayout from "../../layouts/BaseLayout.astro";
import Navbar from "../../components/Navbar.astro";
import Footer from "../../components/Footer.astro";
import OpenQuestions from "../../components/questions/OpenQuestions.astro";
import { useTranslations } from "../../i18n/utils";
import { BLOG } from "../../config";

const lang = "it" as const;
const t = useTranslations(lang);
---

<BaseLayout
  title={`${t.openQuestions.heading} · ${BLOG.name}`}
  description={t.openQuestions.intro}
  lang="it"
  path="/domande-aperte/"
  hreflangIt="/domande-aperte/"
  hreflangEn="/en/open-questions/"
>
  <Navbar itHref="/domande-aperte/" enHref="/en/open-questions/" />
  <main id="main" tabindex="-1">
    <OpenQuestions lang="it" />
  </main>
  <Footer />
</BaseLayout>
