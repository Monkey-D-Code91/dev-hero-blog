---
import BaseLayout from "../../layouts/BaseLayout.astro";
import Navbar from "../../components/Navbar.astro";
import Footer from "../../components/Footer.astro";
import Roadmap from "../../components/roadmap/Roadmap.astro";
import { getResolvedRoadmap } from "../../utils/roadmap";
import { buildRoadmapSchema } from "../../utils/structuredData";
import { useTranslations } from "../../i18n/utils";
import { BLOG } from "../../config";

const lang = "it" as const;
const t = useTranslations(lang);

// Ricarico gli archi (build-time, collection piccola) per il JSON-LD.
const arcs = await getResolvedRoadmap(lang);
const jsonLd = buildRoadmapSchema({
  site: Astro.site,
  lang,
  name: t.roadmap.heading,
  description: t.roadmap.intro,
  canonicalPath: "/roadmap/",
  items: arcs.flatMap((a) =>
    a.items.map((i) => ({ title: i.title, path: i.href }))
  ),
});

const ogImage = new URL("/og/roadmap/it.png", Astro.site).toString();
---

<BaseLayout
  title={`${t.roadmap.heading} · ${BLOG.name}`}
  description={t.roadmap.intro}
  lang="it"
  path="/roadmap/"
  hreflangIt="/roadmap/"
  hreflangEn="/en/roadmap/"
  ogImage={ogImage}
  jsonLd={jsonLd}
>
  <Navbar itHref="/roadmap/" enHref="/en/roadmap/" />
  <main id="main" tabindex="-1">
    <Roadmap lang="it" />
  </main>
  <Footer />
</BaseLayout>
