---
import { getCollection } from "astro:content";
import BaseLayout from "../layouts/BaseLayout.astro";
import Navbar from "../components/Navbar.astro";
import Footer from "../components/Footer.astro";
import LandingHero from "../components/landing/LandingHero.astro";
import RecentPosts from "../components/landing/RecentPosts.astro";
import AuthorsShowcase from "../components/landing/AuthorsShowcase.astro";
import { useTranslations } from "../i18n/utils";
import { getPublishedPosts, getSlugFromEntryId, buildAuthorNameMap } from "../utils/blog";
import { getReadingTime } from "../utils/readingTime";

const t = useTranslations("it");

// Ultimi 3 articoli IT
const allPosts = await getPublishedPosts("it");
const authorMap = await buildAuthorNameMap("it");
const recentPosts = allPosts.slice(0, 3).map((p) => ({
  title: p.data.title,
  description: p.data.description,
  pubDate: p.data.pubDate,
  slug: getSlugFromEntryId(p.id),
  tags: p.data.tags,
  readingTime: getReadingTime(p.body, "it"),
  cover: p.data.cover,
  coverAlt: p.data.coverAlt,
  authorKey: p.data.author,
  authorName: authorMap.get(p.data.author) ?? p.data.author,
}));

// Autori IT per la showcase
const allAuthors = await getCollection("authors");
const itAuthors = allAuthors.filter((a) => a.id.startsWith("it/"));
---

<BaseLayout
  title={t.landing.meta.title}
  description={t.landing.meta.description}
  lang="it"
  path="/"
>
  <Navbar showSections={false} />
  <main id="main">
    <LandingHero lang="it" />
    <RecentPosts posts={recentPosts} lang="it" />
    <AuthorsShowcase authors={itAuthors} lang="it" />
  </main>
  <Footer />
</BaseLayout>
