---
/**
 * AuthorLayout — layout completo per le pagine profilo autore.
 * Usato sia dalla homepage temporanea (index.astro) sia dalle route
 * /autori/[slug]/ e /en/authors/[slug]/.
 *
 * Il corpo markdown dell'autore va passato via slot default — verrà
 * renderizzato nella sezione About.
 */
import BaseLayout from "./BaseLayout.astro";
import Navbar from "../components/Navbar.astro";
import Hero from "../components/Hero.astro";
import About from "../components/About.astro";
import Experience from "../components/Experience.astro";
import Skills from "../components/Skills.astro";
import Contact from "../components/Contact.astro";
import Footer from "../components/Footer.astro";
import AuthorPosts from "../components/blog/AuthorPosts.astro";
import type { CollectionEntry } from "astro:content";
import { buildPersonSchema } from "../utils/structuredData";
import { BLOG } from "../config";

interface Props {
  author: CollectionEntry<"authors">["data"];
  lang: "it" | "en";
  /** URL IT di questa pagina profilo — usato per hreflang e canonical. */
  itHref: string;
  /** URL EN di questa pagina profilo — usato per hreflang. */
  enHref: string;
  title: string;
  description: string;
  articleCount?: number;
}

const { author, lang, itHref, enHref, title, description, articleCount } = Astro.props;

// URL canonico: quello della lingua corrente.
const canonicalPath = lang === "it" ? itHref : enHref;

const rssHref =
  lang === "it"
    ? `/autori/${author.authorKey}/rss.xml`
    : `/en/authors/${author.authorKey}/rss.xml`;
const authorFeed = {
  title: `${BLOG.name} — ${author.name}`,
  href: rssHref,
};

// JSON-LD Person
const personSchema = buildPersonSchema({
  site: Astro.site,
  name: author.name,
  role: author.role,
  description: author.subline,
  canonicalPath,
  imageUrl: author.avatar
    ? new URL(author.avatar.src, Astro.site).toString()
    : undefined,
  sameAs: Object.values(author.links).filter(Boolean) as string[],
  knowsAbout: author.skills.flatMap((s) => s.items),
});
---

<BaseLayout
  title={title}
  description={description}
  lang={lang}
  path={canonicalPath}
  hreflangIt={itHref}
  hreflangEn={enHref}
  jsonLd={personSchema}
  extraFeeds={[authorFeed]}
>
  <Navbar itHref={itHref} enHref={enHref} />
  <main id="main" tabindex="-1">
    <Hero author={author} />
    <About author={author} articleCount={articleCount}>
      <!-- Il corpo markdown viene inserito qui dallo slot del layout -->
      <slot />
    </About>
    <Experience experience={author.experience} />
    <Skills skills={author.skills} />
    <AuthorPosts authorKey={author.authorKey} authorName={author.name} lang={lang} />
    <Contact author={author} />
  </main>
  <Footer linkedin={author.links.linkedin} />
</BaseLayout>
