---
import "@fontsource-variable/inter";
import "../styles/global.css";
import { BLOG } from "../config";
import { isDraftPreview } from "../utils/preview";
import { analyticsToken } from "../utils/analytics";

interface Props {
  title: string;
  description: string;
  lang?: "it" | "en";
  /** Percorso assoluto della pagina (es. "/", "/blog/") per canonical */
  path?: string;
  /** URL assoluto dell'immagine OG (default: /og-image.png del sito). */
  ogImage?: string;
  /** og:type — "website" per le pagine normali, "article" per i post. */
  ogType?: "website" | "article";
  /** Path hreflang IT (default "/") — sovrascrivere per le pagine blog. */
  hreflangIt?: string;
  /** Path hreflang EN (default "/en/") — sovrascrivere per le pagine blog. */
  hreflangEn?: string;
  /** Oggetto/i JSON-LD (schema.org) da serializzare nel <head>. */
  jsonLd?: Record<string, unknown> | Record<string, unknown>[];
  /** Feed RSS aggiuntivi per l'autodiscovery (es. feed per-autore). */
  extraFeeds?: { title: string; href: string }[];
  /**
   * URL canonico esterno (cross-posting). Se presente sovrascrive il canonical
   * calcolato da `path` e viene usato anche in og:url. Gli hreflang non cambiano.
   */
  canonicalUrl?: string;
}

const {
  title,
  description,
  lang = "it",
  path = "/",
  ogImage: ogImageProp,
  ogType = "website",
  hreflangIt = "/",
  hreflangEn = "/en/",
  jsonLd,
  extraFeeds = [],
  canonicalUrl,
} = Astro.props;

// Build di anteprima per il gruppo di feedback: bozze incluse, noindex, banner.
const draftPreview = isDraftPreview();

// Beacon Cloudflare Web Analytics: solo in produzione reale, se configurato.
const cfBeacon = analyticsToken();

const canonical = canonicalUrl ?? new URL(path, Astro.site).toString();
const ogImage = ogImageProp ?? new URL("/og-image.png", Astro.site).toString();

const itHref = new URL(hreflangIt, Astro.site).toString();
const enHref = new URL(hreflangEn, Astro.site).toString();

// Serializza il JSON-LD con escape di "<" per evitare la chiusura prematura del tag script.
const jsonLdString = jsonLd
  ? JSON.stringify(jsonLd).replace(/</g, "\\u003c")
  : null;
---

<!doctype html>
<html lang={lang}>
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <meta name="generator" content={Astro.generator} />

    <title>{title}</title>
    <meta name="description" content={description} />
    {draftPreview && <meta name="robots" content="noindex, nofollow" />}
    <link rel="canonical" href={canonical} />

    <link rel="alternate" hreflang="it" href={itHref} />
    <link rel="alternate" hreflang="en" href={enHref} />
    <link rel="alternate" hreflang="x-default" href={itHref} />

    <!-- Open Graph -->
    <meta property="og:type" content={ogType} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={ogImage} />
    <meta property="og:locale" content={lang === "it" ? "it_IT" : "en_US"} />

    <!-- Twitter -->
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={ogImage} />

    <meta name="theme-color" content="#0b1120" />

    {
      jsonLdString && (
        <script type="application/ld+json" set:html={jsonLdString} />
      )
    }

    <!-- RSS autodiscovery -->
    <link
      rel="alternate"
      type="application/rss+xml"
      title={`${BLOG.name} Blog (IT)`}
      href="/rss.xml"
    />
    <link
      rel="alternate"
      type="application/rss+xml"
      title={`${BLOG.name} Blog (EN)`}
      href="/en/rss.xml"
    />
    {extraFeeds.map((feed) => (
      <link
        rel="alternate"
        type="application/rss+xml"
        title={feed.title}
        href={feed.href}
      />
    ))}
  </head>
  <body>
    <a
      href="#main"
      class="sr-only focus:not-sr-only focus:absolute focus:left-4 focus:top-4 focus:z-50 focus:rounded-md focus:bg-accent focus:px-4 focus:py-2 focus:text-bg"
    >
      {lang === "it" ? "Salta al contenuto" : "Skip to content"}
    </a>
    {
      draftPreview && (
        <div class="border-b border-accent/30 bg-accent/10 px-4 py-2 text-center text-sm text-accent">
          {lang === "it"
            ? "Anteprima di lavoro: include anche le bozze non ancora pubblicate."
            : "Working preview: unpublished drafts are included."}
        </div>
      )
    }
    <slot />

    <script>
      // Reveal on-scroll. Per non penalizzare l'LCP, gli elementi restano
      // VISIBILI di default: nascondiamo (.reveal-hidden) SOLO quelli che al
      // caricamento sono sotto la piega, e li riveliamo quando entrano in vista.
      // Così l'elemento LCP above-the-fold viene dipinto subito.
      const revealEls = document.querySelectorAll<HTMLElement>("[data-reveal]");
      const reduce = window.matchMedia(
        "(prefers-reduced-motion: reduce)"
      ).matches;
      if (!reduce && "IntersectionObserver" in window && revealEls.length) {
        const io = new IntersectionObserver(
          (entries) => {
            for (const entry of entries) {
              if (entry.isIntersecting) {
                entry.target.classList.remove("reveal-hidden");
                io.unobserve(entry.target);
              }
            }
          },
          { threshold: 0.12, rootMargin: "0px 0px -8% 0px" }
        );
        const fold = window.innerHeight * 0.9;
        revealEls.forEach((el) => {
          // Solo gli elementi sotto la piega partono nascosti e animano; quelli
          // già visibili (above-the-fold) non vengono mai toccati.
          if (el.getBoundingClientRect().top > fold) {
            el.classList.add("reveal-hidden");
            io.observe(el);
          }
        });
      }
    </script>

    {
      cfBeacon && (
        <script
          is:inline
          defer
          src="https://static.cloudflareinsights.com/beacon.min.js"
          data-cf-beacon={`{"token": "${cfBeacon}"}`}
        />
      )
    }
  </body>
</html>
